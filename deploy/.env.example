# Copy to .env and edit. Only RUSTYBEE_PUBLIC_URL is required.

# Base URL phones use to reach the server; it goes into pairing links and ws_url.
RUSTYBEE_PUBLIC_URL=https://sms.example.com

# Sets the admin password on first start if none is set yet. Remove it after
# the first login, or change it later with `rustybee set-password`.
RUSTYBEE_ADMIN_PASSWORD=

# Device ping interval in seconds (default 270). Use 60 behind Cloudflare Tunnel.
RUSTYBEE_PING_SECONDS=270

# Hours an undelivered queued message waits before it expires (default 24).
RUSTYBEE_MESSAGE_TTL_HOURS=24

# 1 = trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy (default 0).
RUSTYBEE_TRUST_PROXY=0

# Most queued messages one device may hold; sends beyond it get 429 queue_full (default 1000).
RUSTYBEE_MAX_QUEUED=1000

# 1 = accept recipients with 3-6 digits, for short codes (default 0: at least 7 digits).
RUSTYBEE_ALLOW_SHORT_CODES=0

# Days to keep finished messages and webhook deliveries; empty keeps everything.
# `sent` messages without a delivery report are kept.
RUSTYBEE_RETENTION_DAYS=

# Cloudflare Turnstile on logins that arrive through Cloudflare (optional).
# Set both or neither; needs RUSTYBEE_TRUST_PROXY=1. LAN logins skip it.
RUSTYBEE_TURNSTILE_SITE_KEY=
RUSTYBEE_TURNSTILE_SECRET=

# Path inside the container to a Firebase service-account JSON (optional).
# Enables wake-up pushes to devices that have gone quiet.
RUSTYBEE_FCM_CREDENTIALS=

# Tracing filter (default info).
RUST_LOG=info

# Set by the image; only change these when running the binary directly.
# RUSTYBEE_BIND=0.0.0.0:8080
# RUSTYBEE_DATA_DIR=/data
